<html lang="en">
<head>
  <meta charset="utf-8"/>
  <!-- passed in variables in handlebars are surrounded by two curly braces like the following
       Any variable you pass into res.render will be available by name in the template through
       the curly braces
  -->
  <title>{{title}}</title>
</head>
<body>
  <h1>Welcome to page 3</h1>
  
  <h2>Create a Dog</h2>
  <form id="createDogForm" action="/createDog" method="POST">
    <label for="name">Name: </label>
    <input id="name" type="text" name="name" required />
  
    <label for="breed">Breed: </label>
    <input id="breed" type="text" name="breed" required />
  
    <label for="age">Age: </label>
    <input id="age" type="number" name="age" min="0" required />
  
    <input type="submit" value="Create Dog" />
  </form>
  
  <hr />
  
  <h2>Increase Dog Age</h2>
  <form id="updateDogForm" action="/updateDog" method="POST">
    <label for="searchName">Dog Name: </label>
    <input id="searchName" type="text" name="name" required />
  
    <input type="submit" value="Increase Age" />
  </form>
  <!-- links or URLs are always GET resources as they are getting (retrieving) a resource -->
  <a href="/">Home</a>
  <a href="/page1">Page 1</a>
  <a href="/page2">Page 2</a>
</body>
</html>